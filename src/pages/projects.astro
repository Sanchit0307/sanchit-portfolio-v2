---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import { VERIFIED_PROJECTS } from '../data/siteData';
---

<BaseLayout
  title="Projects"
  description="A collection of projects I've built, from problem-solving ideas to real-world applications."
>
  <PageHeader
    title="Projects"
    description="A collection of projects I've built, from problem-solving ideas to real-world applications."
  />

  <div class="space-y-12">
    {VERIFIED_PROJECTS.map((project) => (
      <article class="group border border-[var(--color-border)] rounded-lg p-6 sm:p-8 bg-[var(--color-surface)] hover:border-[var(--color-primary)]/30 transition-colors">
        <div class="flex flex-col md:flex-row gap-6 md:items-start justify-between">
          <div class="space-y-4 max-w-xl">
            <span class="font-mono text-xs text-[var(--color-secondary)]">{project.num}</span>
            <div class="space-y-2">
              <h2 class="text-xl sm:text-2xl font-medium tracking-tight text-[var(--color-primary)] flex items-center gap-2">
                {project.link ? (
                  <a
                    href={project.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hover:underline flex items-center gap-1.5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[var(--color-primary)] rounded"
                  >
                    <span>{project.title}</span>
                    <span class="text-sm font-normal">↗</span>
                  </a>
                ) : (
                  <span>{project.title}</span>
                )}
              </h2>
              <p class="text-sm sm:text-base text-[var(--color-secondary)] leading-relaxed">
                {project.description}
              </p>
            </div>

            <!-- Tags -->
            <div class="flex flex-wrap gap-2 pt-2">
              {project.tags.map((tag) => (
                <span class="chip">{tag}</span>
              ))}
            </div>
          </div>
        </div>
      </article>
    ))}
  </div>
</BaseLayout>

