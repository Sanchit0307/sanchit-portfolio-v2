---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
---

<BaseLayout
  title="Journey"
  description="A record of my academic journey, certifications, experiences and milestones along the way."
>
  <PageHeader
    title="Learning, growth and milestones."
    description="A record of my academic journey, certifications, experiences and milestones along the way."
  />

  <div class="space-y-12 max-w-4xl" data-animate="stagger">
    <!-- Section 1: Academic Milestones -->
    <section class="space-y-6" data-animate-item>
      <div class="flex items-center gap-2 font-mono text-xs sm:text-sm text-[var(--color-secondary)]">
        <span>/ 01</span>
        <h2 class="text-lg sm:text-xl font-normal text-[var(--color-primary)] font-sans">
          Academic Foundations
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <div class="p-6 rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] shadow-2xs space-y-2.5">
          <div class="flex items-center justify-between text-xs sm:text-[13px] font-mono text-[var(--color-secondary)]">
            <span>2025 – 2029</span>
            <span class="chip text-[11px] px-2 py-0.5">Ongoing</span>
          </div>
          <h3 class="text-base sm:text-lg font-medium text-[var(--color-primary)] pt-1">
            B.Tech Computer Science & Engineering
          </h3>
          <p class="text-sm sm:text-base text-[var(--color-secondary)] leading-relaxed">
            SRM University, Sonepat. Pursuing undergraduate engineering coursework with focus on software development and computer science core.
          </p>
        </div>

        <div class="p-6 rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] shadow-2xs space-y-2.5">
          <div class="flex items-center justify-between text-xs sm:text-[13px] font-mono text-[var(--color-secondary)]">
            <span>CBSE</span>
            <span class="chip text-[11px] px-2 py-0.5">Completed</span>
          </div>
          <h3 class="text-base sm:text-lg font-medium text-[var(--color-primary)] pt-1">
            Senior Secondary (Class 12)
          </h3>
          <p class="text-sm sm:text-base text-[var(--color-secondary)] leading-relaxed">
            Central Board of Secondary Education. Completed secondary qualification with science and mathematics discipline.
          </p>
        </div>

        <div class="p-6 rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] shadow-2xs space-y-2.5">
          <div class="flex items-center justify-between text-xs sm:text-[13px] font-mono text-[var(--color-secondary)]">
            <span>CBSE</span>
            <span class="chip text-[11px] px-2 py-0.5">Completed</span>
          </div>
          <h3 class="text-base sm:text-lg font-medium text-[var(--color-primary)] pt-1">
            Secondary Education (Class 10)
          </h3>
          <p class="text-sm sm:text-base text-[var(--color-secondary)] leading-relaxed">
            Doon Public School, Paschim Vihar, New Delhi. Completed secondary schooling curriculum.
          </p>
        </div>
      </div>
    </section>

    <!-- Section 2: Technical Platform Deployments -->
    <section class="space-y-6" data-animate-item>
      <div class="flex items-center gap-2 font-mono text-xs sm:text-sm text-[var(--color-secondary)]">
        <span>/ 02</span>
        <h2 class="text-lg sm:text-xl font-normal text-[var(--color-primary)] font-sans">
          Technical Platform Releases
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <div class="p-6 rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] shadow-2xs space-y-2.5">
          <div class="flex items-center justify-between text-xs sm:text-[13px] font-mono text-[var(--color-secondary)]">
            <span>Civic Platform</span>
            <a href="https://delhicomplaintportal.vercel.app" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--color-primary)] transition-colors">
              Live Deployment ↗
            </a>
          </div>
          <h3 class="text-base sm:text-lg font-medium text-[var(--color-primary)]">
            Delhi NCR Complaint Portal
          </h3>
          <p class="text-sm sm:text-base text-[var(--color-secondary)] leading-relaxed">
            Built an AI-assisted formal grievance drafting tool serving citizens across Delhi NCR with direct routing to municipal administrative bodies.
          </p>
        </div>

        <div class="p-6 rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] shadow-2xs space-y-2.5">
          <div class="flex items-center justify-between text-xs sm:text-[13px] font-mono text-[var(--color-secondary)]">
            <span>Collaborative System</span>
            <a href="https://aryan689t.github.io/KisanSetu_V1/" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--color-primary)] transition-colors">
              Live Platform ↗
            </a>
          </div>
          <h3 class="text-base sm:text-lg font-medium text-[var(--color-primary)]">
            Annagati (formerly Kisan Setu)
          </h3>
          <p class="text-sm sm:text-base text-[var(--color-secondary)] leading-relaxed">
            Architected frontend development and user authorization for an agricultural mandi queue and MSP digital token booking platform.
          </p>
        </div>
      </div>
    </section>

    <!-- Section 3: Engineering Consistency Note -->
    <section class="p-6 rounded-2xl border border-[var(--color-border)] bg-[var(--color-muted)] space-y-2" data-animate-item>
      <div class="flex items-center gap-2 text-xs sm:text-[13px] font-medium text-[var(--color-primary)]">
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        <span>Ongoing Milestones</span>
      </div>
      <p class="text-sm sm:text-base text-[var(--color-secondary)] leading-relaxed">
        Active participation in hackathons, competitive programming, and technical contributions will be documented here as results are officially validated. All milestones presented here reflect verified achievements only.
      </p>
    </section>
  </div>
</BaseLayout>
