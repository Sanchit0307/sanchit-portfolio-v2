---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ui/ProjectCard.astro';
import { PERSONAL_INFO, VERIFIED_PROJECTS } from '../data/siteData';

const featuredProjects = VERIFIED_PROJECTS.filter((p) => p.featured);
---

<BaseLayout>
  <div class="space-y-16 sm:space-y-20">
    <!-- Top Identity / Meta Bar -->
    <div class="flex items-center justify-between text-xs sm:text-sm text-[var(--color-secondary)] pb-6 border-b border-[var(--color-border)]">
      <span class="font-medium text-[var(--color-primary)]">{PERSONAL_INFO.name}</span>
      <div class="flex items-center gap-2 font-mono text-xs">
        <span class="text-[var(--color-secondary)]">/ {PERSONAL_INFO.branch}</span>
        <span>{PERSONAL_INFO.batch}</span>
      </div>
    </div>

    <!-- Hero Section -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7 space-y-6">
        <h1 class="text-3xl sm:text-5xl lg:text-5xl font-normal tracking-tight text-[var(--color-primary)] leading-[1.1]">
          {PERSONAL_INFO.role}
        </h1>
        <p class="text-base sm:text-lg text-[var(--color-secondary)] leading-relaxed max-w-xl">
          {PERSONAL_INFO.bio}
        </p>

        <!-- Primary Action Controls -->
        <div class="flex flex-wrap items-center gap-3 pt-2">
          <a href="/projects" class="btn-primary">
            <span>View Projects</span>
            <span class="text-xs">↗</span>
          </a>
          <a href={PERSONAL_INFO.resumeUrl} target="_blank" rel="noopener noreferrer" class="btn-secondary">
            <span>Resume</span>
            <span class="text-xs">↓</span>
          </a>
          <a
            href={PERSONAL_INFO.github}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-icon"
            aria-label="GitHub Profile"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
            </svg>
          </a>
          <a
            href={PERSONAL_INFO.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-icon"
            aria-label="LinkedIn Profile"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76a1.64 1.64 0 1 0 0-3.28 1.64 1.64 0 0 0 0 3.28m1.39 9.74v-8.37H5.07v8.37h2.78z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Portrait Container (Grayscale by default, color transition on hover) -->
      <div class="lg:col-span-5 flex justify-center lg:justify-end">
        <div class="relative w-64 h-80 sm:w-72 sm:h-92 rounded-2xl overflow-hidden border border-[var(--color-border)] bg-[var(--color-muted)] shadow-xs">
          <img
            src="/images/portrait.jpg"
            alt="Sanchit Marwah portrait"
            class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-500 ease-in-out cursor-pointer"
            loading="eager"
            decoding="async"
          />
        </div>
      </div>
    </div>

    <!-- Featured Work Section -->
    <section class="space-y-8 pt-8 border-t border-[var(--color-border)]">
      <div class="flex items-center justify-between text-xs sm:text-sm">
        <div class="flex items-center gap-2 font-mono text-[var(--color-secondary)]">
          <span>/ 01</span>
          <span class="font-sans font-medium text-[var(--color-primary)]">Featured Work</span>
        </div>
        <a href="/projects" class="text-[var(--color-secondary)] hover:text-[var(--color-primary)] transition-colors inline-flex items-center gap-1 font-medium">
          <span>View All Projects</span>
          <span>↗</span>
        </a>
      </div>

      <div class="space-y-8 sm:space-y-10">
        {featuredProjects.map((project, index) => (
          <ProjectCard project={project} priority={index === 0} />
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
