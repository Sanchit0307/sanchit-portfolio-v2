---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ui/ProjectCard.astro';
import TechIcon from '../components/ui/TechIcon.astro';
import ContactForm from '../components/ui/ContactForm';
import {
  PERSONAL_INFO,
  VERIFIED_PROJECTS,
  VERIFIED_SKILLS,
  VERIFIED_EDUCATION,
} from '../data/siteData';
---

<BaseLayout>
  <div class="space-y-24 sm:space-y-32">
    <!-- Top Identity / Meta Bar -->
    <div class="flex items-center justify-between text-xs sm:text-sm text-[var(--color-secondary)] pb-6 border-b border-[var(--color-border)]">
      <span class="font-mono text-xs text-[var(--color-secondary)] tracking-widest uppercase">PORTFOLIO</span>
      <div class="flex items-center gap-2 font-mono text-xs sm:text-sm">
        <span class="text-[var(--color-secondary)]">/ {PERSONAL_INFO.branch}</span>
        <span>{PERSONAL_INFO.batch}</span>
      </div>
    </div>

    <!-- 1. HERO SECTION -->
    <section id="hero" class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
      <div class="lg:col-span-7 xl:col-span-7 flex flex-col justify-center space-y-5 sm:space-y-6">
        <!-- 1. Eyebrow text -->
        <div data-hero-animate>
          <span class="text-xs sm:text-sm font-mono tracking-widest uppercase text-[var(--color-secondary)] font-medium block">
            HEY THERE, I'M
          </span>
        </div>

        <!-- 2. Oversized Name Heading & 3. Professional Introduction -->
        <div data-hero-animate class="space-y-3 sm:space-y-4">
          <h1 class="text-5xl sm:text-6xl md:text-7xl lg:text-[5.5rem] xl:text-[6rem] font-bold tracking-[-0.04em] text-[var(--color-primary)] leading-[0.95]">
            Sanchit Marwah.
          </h1>

          <p class="text-2xl sm:text-3xl md:text-4xl lg:text-[3.25rem] xl:text-[3.5rem] font-normal tracking-tight text-[var(--color-secondary)] leading-[1.08]">
            Computer Science<br class="hidden sm:inline" /> Student & Web Developer.
          </p>
        </div>

        <!-- 4. Supporting paragraph -->
        <p data-hero-animate class="text-base sm:text-lg lg:text-xl text-[var(--color-secondary)] leading-relaxed max-w-2xl pt-1">
          {PERSONAL_INFO.bio}
        </p>

        <!-- 5. Primary Action Controls -->
        <div data-hero-animate class="flex flex-wrap items-center gap-3.5 pt-2">
          <a href="#projects" class="btn-primary">
            <span>View Projects</span>
            <span class="text-xs">↓</span>
          </a>
          <a href={PERSONAL_INFO.resumeUrl} target="_blank" rel="noopener noreferrer" class="btn-secondary">
            <span>Resume</span>
            <span class="text-xs">↗</span>
          </a>
          <a
            href={PERSONAL_INFO.github}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-icon"
            aria-label="GitHub Profile"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
            </svg>
          </a>
          <a
            href={PERSONAL_INFO.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-icon"
            aria-label="LinkedIn Profile"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76a1.64 1.64 0 1 0 0-3.28 1.64 1.64 0 0 0 0 3.28m1.39 9.74v-8.37H5.07v8.37h2.78z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Portrait Container (Preserving original placement and interaction) -->
      <div class="lg:col-span-5 xl:col-span-5 flex justify-center lg:justify-end">
        <div data-hero-portrait class="relative w-64 h-80 sm:w-76 sm:h-96 lg:w-84 lg:h-[430px] rounded-2xl overflow-hidden border border-[var(--color-border)] bg-[var(--color-muted)] shadow-xs">
          <img
            src="/images/portrait.jpg"
            alt="Sanchit Marwah portrait"
            class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-500 ease-in-out cursor-pointer"
            loading="eager"
            decoding="async"
          />
        </div>
      </div>
    </section>

    <!-- 2. SECTION A: PHILOSOPHY AND FOCUS -->
    <section id="philosophy" class="space-y-8 pt-12 border-t border-[var(--color-border)] scroll-mt-24" data-animate="fade-up">
      <div class="flex items-center gap-2 font-mono text-xs sm:text-sm text-[var(--color-secondary)]">
        <span>/ 01</span>
        <span class="font-sans font-medium text-[var(--color-primary)] text-sm sm:text-base">Philosophy & Focus</span>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
        <!-- Left Column: Approach to Software Development -->
        <div class="lg:col-span-6 space-y-4 p-6 sm:p-8 rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] shadow-2xs">
          <span class="text-xs font-mono uppercase tracking-wider text-[var(--color-secondary)] block">
            Engineering Approach
          </span>
          <h2 class="text-xl sm:text-2xl font-normal tracking-tight text-[var(--color-primary)] leading-snug">
            Building practical software grounded in solid fundamentals.
          </h2>
          <p class="text-sm text-[var(--color-secondary)] leading-relaxed">
            As a first-year Computer Science and Engineering student at SRM University, my focus centers on understanding core computing fundamentals before reaching for high-level abstractions. I believe genuine engineering skill is forged by solving real-world challenges with readable, maintainable, and pragmatic code.
          </p>
          <p class="text-sm text-[var(--color-secondary)] leading-relaxed">
            Rather than assembling superficial demo projects, I prioritize building functional platforms that serve genuine human needs—such as civic grievance portals and campus collaboration systems. Every project is an opportunity for iterative experimentation, debugging, and continuous technical growth.
          </p>
        </div>

        <!-- Right Column: Current Interests & Technical Areas -->
        <div class="lg:col-span-6 space-y-4 p-6 sm:p-8 rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] shadow-2xs">
          <span class="text-xs font-mono uppercase tracking-wider text-[var(--color-secondary)] block">
            Current Focus Areas
          </span>
          <h2 class="text-xl sm:text-2xl font-normal tracking-tight text-[var(--color-primary)] leading-snug">
            What I'm exploring and actively refining.
          </h2>

          <ul class="space-y-3 pt-2 text-sm text-[var(--color-secondary)] font-sans">
            <li class="flex items-start gap-3">
              <span class="font-mono text-xs text-[var(--color-primary)] mt-1">01</span>
              <div>
                <strong class="text-[var(--color-primary)] font-medium">Modern Web Development:</strong>
                <span> Component-driven architectures, responsive layout systems, and accessible interfaces.</span>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="font-mono text-xs text-[var(--color-primary)] mt-1">02</span>
              <div>
                <strong class="text-[var(--color-primary)] font-medium">Full-Stack Architecture:</strong>
                <span> Connecting reactive frontends with REST/GraphQL APIs, relational data stores, and serverless backends.</span>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="font-mono text-xs text-[var(--color-primary)] mt-1">03</span>
              <div>
                <strong class="text-[var(--color-primary)] font-medium">Data Structures & Algorithms:</strong>
                <span> Strengthening disciplined problem-solving and algorithmic complexity analysis in foundational languages.</span>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="font-mono text-xs text-[var(--color-primary)] mt-1">04</span>
              <div>
                <strong class="text-[var(--color-primary)] font-medium">Open-Source & Collaboration:</strong>
                <span> Learning from public codebases, version control workflows with Git, and community peer review.</span>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <span class="font-mono text-xs text-[var(--color-primary)] mt-1">05</span>
              <div>
                <strong class="text-[var(--color-primary)] font-medium">Software Engineering Rigor:</strong>
                <span> Modular structure, meaningful documentation, and thoughtful error handling.</span>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- 3. SECTION B: SELECTED PROJECTS -->
    <section id="projects" class="space-y-8 pt-12 border-t border-[var(--color-border)] scroll-mt-24" data-animate="fade-up">
      <div class="flex items-center justify-between text-xs sm:text-sm">
        <div class="flex items-center gap-2 font-mono text-[var(--color-secondary)]">
          <span>/ 02</span>
          <span class="font-sans font-medium text-[var(--color-primary)] text-sm sm:text-base">Selected Projects</span>
        </div>
        <a href="/projects" class="text-[var(--color-secondary)] hover:text-[var(--color-primary)] transition-colors inline-flex items-center gap-1 font-medium">
          <span>View All Projects</span>
          <span>↗</span>
        </a>
      </div>

      <div class="space-y-8 sm:space-y-10" data-animate="stagger">
        {VERIFIED_PROJECTS.map((project, index) => (
          <div data-animate-item>
            <ProjectCard project={project} priority={index === 0} />
          </div>
        ))}
      </div>
    </section>

    <!-- 4. SECTION C: SKILLS AND TECHNOLOGIES -->
    <section id="skills" class="space-y-8 pt-12 border-t border-[var(--color-border)] scroll-mt-24" data-animate="fade-up">
      <div class="flex items-center justify-between text-xs sm:text-sm">
        <div class="flex items-center gap-2 font-mono text-[var(--color-secondary)]">
          <span>/ 03</span>
          <span class="font-sans font-medium text-[var(--color-primary)] text-sm sm:text-base">Skills & Technologies</span>
        </div>
        <a href="/skills" class="text-[var(--color-secondary)] hover:text-[var(--color-primary)] transition-colors inline-flex items-center gap-1 font-medium">
          <span>Explore Full Stack Details</span>
          <span>↗</span>
        </a>
      </div>

      <div class="p-6 sm:p-8 rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] shadow-2xs space-y-8">
        <div class="space-y-1 max-w-xl">
          <h3 class="text-lg font-normal tracking-tight text-[var(--color-primary)]">
            Technical Stack & Workflow
          </h3>
          <p class="text-xs text-[var(--color-secondary)]">
            Core technologies and tools I work with across frontend and full-stack development.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8" data-animate="stagger">
          {VERIFIED_SKILLS.map((section) => (
            <div class="space-y-4" data-animate-item>
              <h4 class="text-xs font-mono uppercase tracking-wider text-[var(--color-secondary)] pb-2 border-b border-[var(--color-border)]">
                {section.category}
              </h4>
              <div class="flex flex-wrap gap-3">
                {section.items.map((skill) => (
                  <div class="flex items-center gap-2.5 px-3 py-2 rounded-xl border border-[var(--color-border)] bg-[var(--bg-page)] hover:border-[var(--color-primary)]/40 transition-colors shadow-2xs group">
                    <div class="w-5 h-5 flex items-center justify-center shrink-0">
                      <TechIcon name={skill.name} />
                    </div>
                    <span class="text-xs text-[var(--color-primary)] font-medium">
                      {skill.name}
                    </span>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 5. SECTION D: CURRENT JOURNEY -->
    <section id="journey" class="space-y-8 pt-12 border-t border-[var(--color-border)] scroll-mt-24" data-animate="fade-up">
      <div class="flex items-center justify-between text-xs sm:text-sm">
        <div class="flex items-center gap-2 font-mono text-[var(--color-secondary)]">
          <span>/ 04</span>
          <span class="font-sans font-medium text-[var(--color-primary)] text-sm sm:text-base">Current Journey</span>
        </div>
        <a href="/journey" class="text-[var(--color-secondary)] hover:text-[var(--color-primary)] transition-colors inline-flex items-center gap-1 font-medium">
          <span>View Complete Journey Details</span>
          <span>↗</span>
        </a>
      </div>

      <div class="p-6 sm:p-8 rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] shadow-2xs space-y-6">
        <div class="space-y-1">
          <h3 class="text-lg font-normal tracking-tight text-[var(--color-primary)]">
            Academic & Development Milestones
          </h3>
          <p class="text-xs text-[var(--color-secondary)]">
            Educational timeline from secondary school to ongoing university computer science studies.
          </p>
        </div>

        <div class="relative pl-6 sm:pl-8 ml-2 space-y-8" data-animate="stagger">
          <!-- Animated vertical timeline line -->
          <div
            data-timeline-track
            class="absolute left-0 top-2 bottom-2 w-[1px] bg-[var(--color-border)] origin-top transition-transform duration-700"
            aria-hidden="true"
          />

          {VERIFIED_EDUCATION.map((item) => {
            const isOngoing = item.status === 'Ongoing';
            return (
              <div class="relative group" data-animate-item>
                <!-- Indicator Node -->
                <div
                  class:list={[
                    'absolute -left-[29px] sm:-left-[37px] top-1.5 w-3 h-3 rounded-full transition-transform duration-300 group-hover:scale-125',
                    isOngoing
                      ? 'bg-[var(--color-primary)] ring-4 ring-[var(--color-primary)]/20'
                      : 'bg-[var(--color-secondary)] ring-4 ring-[var(--bg-page)]'
                  ]}
                  aria-hidden="true"
                />

                <div class="space-y-1.5 max-w-2xl">
                  <div class="flex flex-wrap items-center gap-2.5 text-xs">
                    <span class="font-medium text-[var(--color-primary)]">
                      {item.stage}
                    </span>
                    {item.period && <span class="font-mono text-[var(--color-secondary)]">{item.period}</span>}
                    <span
                      class:list={[
                        'px-2 py-0.5 rounded-full border text-[10px] font-mono',
                        isOngoing
                          ? 'border-[var(--color-primary)] text-[var(--color-primary)] font-medium'
                          : 'border-[var(--color-border)] text-[var(--color-secondary)]'
                      ]}
                    >
                      {item.status}
                    </span>
                  </div>

                  {item.institution && (
                    <h4 class="text-sm font-medium text-[var(--color-primary)]">
                      {item.institution}
                    </h4>
                  )}
                  {item.board && (
                    <h4 class="text-sm font-medium text-[var(--color-primary)]">
                      {item.board}
                    </h4>
                  )}

                  <p class="text-xs text-[var(--color-secondary)] leading-relaxed pt-0.5">
                    {item.description}
                  </p>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- 6. SECTION E: CONTACT SECTION AT THE BOTTOM -->
    <section id="contact" class="space-y-8 pt-12 border-t border-[var(--color-border)] scroll-mt-24" data-animate="fade-up">
      <div class="flex items-center gap-2 font-mono text-xs sm:text-sm text-[var(--color-secondary)]">
        <span>/ 05</span>
        <span class="font-sans font-medium text-[var(--color-primary)] text-sm sm:text-base">Contact & Connect</span>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
        <!-- Left: Statement & Direct Coordinates -->
        <div class="lg:col-span-5 space-y-6">
          <div class="space-y-3">
            <h2 class="text-3xl sm:text-4xl font-normal tracking-tight text-[var(--color-primary)] leading-tight">
              Let's build something meaningful.
            </h2>
            <p class="text-sm text-[var(--color-secondary)] leading-relaxed">
              Interested in web development, engineering, open-source collaboration or building useful products? I'd be happy to connect.
            </p>
          </div>

          <!-- Direct Channels Cards -->
          <div class="space-y-3 pt-2">
            <a
              href={`mailto:${PERSONAL_INFO.email}`}
              class="flex items-center justify-between p-4 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] hover:border-[var(--color-primary)]/40 transition-colors group"
            >
              <div>
                <span class="text-[11px] font-mono text-[var(--color-secondary)] block">Direct Email</span>
                <span class="text-sm font-medium text-[var(--color-primary)]">{PERSONAL_INFO.email}</span>
              </div>
              <span class="text-xs text-[var(--color-secondary)] group-hover:text-[var(--color-primary)] transition-colors">↗</span>
            </a>

            <a
              href={PERSONAL_INFO.github}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-between p-4 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] hover:border-[var(--color-primary)]/40 transition-colors group"
            >
              <div>
                <span class="text-[11px] font-mono text-[var(--color-secondary)] block">GitHub Activity</span>
                <span class="text-sm font-medium text-[var(--color-primary)]">github.com/Sanchit0307</span>
              </div>
              <span class="text-xs text-[var(--color-secondary)] group-hover:text-[var(--color-primary)] transition-colors">↗</span>
            </a>

            <a
              href={PERSONAL_INFO.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-between p-4 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] hover:border-[var(--color-primary)]/40 transition-colors group"
            >
              <div>
                <span class="text-[11px] font-mono text-[var(--color-secondary)] block">Professional Profile</span>
                <span class="text-sm font-medium text-[var(--color-primary)]">linkedin.com/in/sanchit-marwah</span>
              </div>
              <span class="text-xs text-[var(--color-secondary)] group-hover:text-[var(--color-primary)] transition-colors">↗</span>
            </a>
          </div>
        </div>

        <!-- Right: Contact Form -->
        <div class="lg:col-span-7">
          <ContactForm client:load />
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
