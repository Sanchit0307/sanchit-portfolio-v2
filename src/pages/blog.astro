---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
---

<BaseLayout
  title="Blog"
  description="Writing and technical notes by Sanchit Marwah."
>
  <PageHeader
    title="Blog & Technical Notes"
    description="Essays, documentation, and technical notes on full-stack development, algorithms, and project engineering."
  />

  <div class="space-y-12 max-w-3xl" data-animate="fade-up">
    <!-- Notice Card -->
    <div class="p-8 rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] shadow-2xs space-y-4">
      <div class="flex items-center gap-2.5">
        <span class="w-2.5 h-2.5 rounded-full bg-blue-500 animate-pulse"></span>
        <span class="text-xs font-mono uppercase tracking-wider text-[var(--color-secondary)]">Writing in Progress</span>
      </div>

      <h2 class="text-xl font-normal tracking-tight text-[var(--color-primary)]">
        Engineering notes and write-ups coming soon
      </h2>

      <p class="text-sm text-[var(--color-secondary)] leading-relaxed">
        I am currently drafting technical documentation and project retrospectives based on my work with civic platforms, full-stack architectures, and foundational computer science concepts. As each article is finalized, it will be published here.
      </p>

      <div class="pt-4 border-t border-[var(--color-border)] flex flex-wrap gap-2 text-xs font-mono text-[var(--color-secondary)]">
        <span class="chip px-2.5 py-1">#WebDevelopment</span>
        <span class="chip px-2.5 py-1">#Nextjs</span>
        <span class="chip px-2.5 py-1">#SystemDesign</span>
        <span class="chip px-2.5 py-1">#DataStructures</span>
      </div>
    </div>

    <!-- Planned Editorial Topics (Genuine interests, no fake articles) -->
    <div class="space-y-4 pt-4">
      <h3 class="text-xs font-mono uppercase tracking-wider text-[var(--color-secondary)]">
        Upcoming Topics
      </h3>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="p-5 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)]/60 space-y-2">
          <span class="text-xs font-mono text-[var(--color-secondary)]">01 / Project Architecture</span>
          <h4 class="text-sm font-medium text-[var(--color-primary)]">
            Structuring Citizen Redressal Platforms with Next.js and AI APIs
          </h4>
          <p class="text-xs text-[var(--color-secondary)] leading-relaxed">
            Reflections and engineering takeaways from architecting the Delhi NCR Complaint Portal.
          </p>
        </div>

        <div class="p-5 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)]/60 space-y-2">
          <span class="text-xs font-mono text-[var(--color-secondary)]">02 / Fundamentals</span>
          <h4 class="text-sm font-medium text-[var(--color-primary)]">
            A First-Year Perspective on Data Structures & Algorithmic Problem Solving
          </h4>
          <p class="text-xs text-[var(--color-secondary)] leading-relaxed">
            Building disciplined problem-solving habits early in an undergraduate engineering journey.
          </p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
