---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import { VERIFIED_SKILLS } from '../data/siteData';
---

<BaseLayout
  title="Stack"
  description="Technologies and tools I use to build, ship and iterate."
>
  <PageHeader
    title="Stack"
    description="Technologies and tools I use to build, ship and iterate."
  />

  <div class="space-y-12">
    {VERIFIED_SKILLS.map((section) => (
      <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-start pb-10 border-b border-[var(--color-border)] last:border-b-0">
        <div class="md:col-span-3">
          <h2 class="text-sm font-medium text-[var(--color-primary)]">
            {section.category}
          </h2>
        </div>
        <div class="md:col-span-9 flex flex-wrap gap-4 sm:gap-6">
          {section.items.map((skill) => (
            <div class="flex flex-col items-center gap-2 group">
              <div class="w-16 h-16 sm:w-18 sm:h-18 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] flex items-center justify-center p-3 text-[var(--color-primary)] group-hover:border-[var(--color-primary)]/40 transition-colors shadow-2xs">
                <span class="text-xs font-mono font-medium">{skill.name.slice(0, 3)}</span>
              </div>
              <span class="text-xs text-[var(--color-secondary)] group-hover:text-[var(--color-primary)] transition-colors">
                {skill.name}
              </span>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</BaseLayout>

