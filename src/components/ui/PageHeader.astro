---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<div class="mb-12">
  <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-4 pb-8 border-b border-[var(--color-border)]">
    <h1 class="text-2xl sm:text-3xl font-normal tracking-tight text-[var(--color-primary)] flex items-center gap-2">
      <span class="text-[var(--color-secondary)] font-normal">/</span>
      <span>{title}</span>
    </h1>
    <p class="text-sm text-[var(--color-secondary)] max-w-sm sm:text-right leading-relaxed">
      {description}
    </p>
  </div>
</div>
