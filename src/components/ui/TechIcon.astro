---
import {
  siHtml5,
  siCss3,
  siJavascript,
  siReact,
  siTailwindcss,
  siNodedotjs,
  siSupabase,
  siPython,
  siGit,
  siGithub,
} from 'simple-icons';

interface Props {
  name: string;
}

const { name } = Astro.props;

// VS Code official path
const vscodePath = 'M23.15 2.587L18.21.21a1.494 1.494 0 0 0-1.705.29l-9.46 8.63-4.12-3.128a.999.999 0 0 0-1.276.057L.327 7.261A1 1 0 0 0 .326 8.74L3.899 12 .326 15.26a1 1 0 0 0 .001 1.479L1.65 17.94a.999.999 0 0 0 1.276.057l4.12-3.128 9.46 8.63a1.492 1.492 0 0 0 1.704.29l4.94-2.377A1.5 1.5 0 0 0 24 20.06V3.939a1.5 1.5 0 0 0-.85-1.352zm-5.146 14.861L10.826 12l7.178-5.448v10.896z';
---

{name === 'HTML5' || name === 'HTML' ? (
  <svg viewBox="0 0 24 24" class="w-7 h-7 transition-transform duration-200 group-hover:scale-110" aria-label="HTML5">
    <path fill="#E34F26" d={siHtml5.path} />
  </svg>
) : name === 'CSS3' || name === 'CSS' ? (
  <svg viewBox="0 0 24 24" class="w-7 h-7 transition-transform duration-200 group-hover:scale-110" aria-label="CSS3">
    <path fill="#1572B6" d={siCss3.path} />
  </svg>
) : name === 'JavaScript' ? (
  <svg viewBox="0 0 24 24" class="w-7 h-7 rounded-sm transition-transform duration-200 group-hover:scale-110" aria-label="JavaScript">
    <rect width="24" height="24" rx="3" fill="#F7DF1E" />
    <path fill="#000000" d={siJavascript.path} />
  </svg>
) : name === 'React' ? (
  <svg viewBox="0 0 24 24" class="w-7 h-7 transition-transform duration-200 group-hover:scale-110" aria-label="React">
    <path fill="#61DAFB" d={siReact.path} />
  </svg>
) : name === 'Tailwind' || name === 'Tailwind CSS' ? (
  <svg viewBox="0 0 24 24" class="w-7 h-7 transition-transform duration-200 group-hover:scale-110" aria-label="Tailwind CSS">
    <path fill="#06B6D4" d={siTailwindcss.path} />
  </svg>
) : name === 'Node.js' ? (
  <svg viewBox="0 0 24 24" class="w-7 h-7 transition-transform duration-200 group-hover:scale-110" aria-label="Node.js">
    <path fill="#5FA04E" d={siNodedotjs.path} />
  </svg>
) : name === 'Supabase' ? (
  <svg viewBox="0 0 24 24" class="w-7 h-7 transition-transform duration-200 group-hover:scale-110" aria-label="Supabase">
    <path fill="#3ECF8E" d={siSupabase.path} />
  </svg>
) : name === 'Python' ? (
  <svg viewBox="0 0 24 24" class="w-7 h-7 transition-transform duration-200 group-hover:scale-110" aria-label="Python">
    <path fill="#3776AB" d="M11.91 0c-3.15 0-5.18.34-5.18 2.05v2.73h5.27v.77H4.63C2.86 5.55 1.5 6.84 1.5 9.77c0 3.32 1.63 4.24 3.73 4.24h1.4v-1.99c0-1.77 1.48-3.23 3.28-3.23h5.18V5.33c0-1.8-1.57-3.28-3.37-3.28H9.98V.01h1.93zm-2.07 1.46a.82.82 0 1 1 0 1.64.82.82 0 0 1 0-1.64z" />
    <path fill="#FFD43B" d="M12.09 24c3.15 0 5.18-.34 5.18-2.05v-2.73H12v-.77h7.37c1.77 0 3.13-1.29 3.13-4.22 0-3.32-1.63-4.24-3.73-4.24h-1.4v1.99c0 1.77-1.48 3.23-3.28 3.23H8.91v3.46c0 1.8 1.57 3.28 3.37 3.28h1.74v2.05h-1.93zm2.07-1.46a.82.82 0 1 1 0-1.64.82.82 0 0 1 0 1.64z" />
  </svg>
) : name === 'Git' ? (
  <svg viewBox="0 0 24 24" class="w-7 h-7 transition-transform duration-200 group-hover:scale-110" aria-label="Git">
    <path fill="#F05032" d={siGit.path} />
  </svg>
) : name === 'GitHub' ? (
  <svg viewBox="0 0 24 24" class="w-7 h-7 transition-transform duration-200 group-hover:scale-110" aria-label="GitHub">
    <path class="fill-[#181717] dark:fill-[#FFFFFF] transition-colors" d={siGithub.path} />
  </svg>
) : name === 'VS Code' ? (
  <svg viewBox="0 0 24 24" class="w-7 h-7 transition-transform duration-200 group-hover:scale-110" aria-label="VS Code">
    <path fill="#007ACC" d={vscodePath} />
  </svg>
) : name === 'Figma' ? (
  <svg viewBox="0 0 24 24" class="w-7 h-7 transition-transform duration-200 group-hover:scale-110" aria-label="Figma">
    <path fill="#F24E1E" d="M12 12A3 3 0 0 0 9 9H6a3 3 0 0 0 0 6h3a3 3 0 0 0 3-3z" />
    <path fill="#A259FF" d="M12 6A3 3 0 0 0 9 3H6a3 3 0 0 0 0 6h3a3 3 0 0 0 3-3z" />
    <path fill="#FF7262" d="M15 3h-3v6h3a3 3 0 0 0 0-6z" />
    <path fill="#1ABCFE" d="M15 9h-3v6h3a3 3 0 0 0 0-6z" />
    <path fill="#0ACF83" d="M6 15a3 3 0 0 0 3 3v3a3 3 0 0 1-3-3z" />
  </svg>
) : (
  <span class="text-xs font-mono font-medium">{name.slice(0, 3)}</span>
)}
