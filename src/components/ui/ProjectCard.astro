---
import type { Project } from '../../data/siteData';

interface Props {
  project: Project;
  priority?: boolean;
  class?: string;
}

const { project, priority = false, class: className = '' } = Astro.props;
---

<article class:list={[
  'group border border-[var(--color-border)] rounded-2xl bg-[var(--color-surface)] p-6 sm:p-8 transition-all duration-300 hover:border-[var(--color-primary)]/40 hover:-translate-y-0.5 hover:shadow-sm',
  className
]}>
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
    <!-- Left Column: 16:10 Framed Image Container -->
    <div class="lg:col-span-7 w-full">
      <div class="relative w-full aspect-[16/10] overflow-hidden rounded-xl border border-[var(--color-border)] bg-[var(--color-muted)] flex items-center justify-center p-3 sm:p-4">
        {project.link ? (
          <a
            href={project.link}
            target="_blank"
            rel="noopener noreferrer"
            class="block w-full h-full flex items-center justify-center focus-visible:outline focus-visible:outline-2 focus-visible:outline-[var(--color-primary)] rounded"
            tabindex="-1"
            aria-hidden="true"
          >
            <img
              src={project.image}
              alt={`${project.title} interface preview`}
              class="w-full h-full object-contain object-center rounded transition-transform duration-300 ease-out group-hover:scale-[1.01]"
              loading={priority ? 'eager' : 'lazy'}
              decoding="async"
            />
          </a>
        ) : (
          <div class="w-full h-full flex items-center justify-center">
            <img
              src={project.image}
              alt={`${project.title} interface preview`}
              class="w-full h-full object-contain object-center rounded transition-transform duration-300 ease-out group-hover:scale-[1.01]"
              loading={priority ? 'eager' : 'lazy'}
              decoding="async"
            />
          </div>
        )}
      </div>
    </div>

    <!-- Right Column: Project Details & Meta -->
    <div class="lg:col-span-5 flex flex-col justify-between space-y-5">
      <!-- Monospace Index and Role/Type Badge -->
      <div class="flex items-center justify-between text-xs sm:text-[13px]">
        <span class="font-mono text-[var(--color-secondary)] tracking-wider">
          {project.num}
        </span>
        {project.role ? (
          <span class="font-mono text-xs px-3 py-1 rounded-full border border-[var(--color-border)] bg-[var(--color-muted)] text-[var(--color-secondary)]">
            Role: {project.role}
          </span>
        ) : project.type ? (
          <span class="font-mono text-xs px-3 py-1 rounded-full border border-[var(--color-border)] bg-[var(--color-muted)] text-[var(--color-secondary)]">
            {project.type}
          </span>
        ) : null}
      </div>

      <!-- Title & Description -->
      <div class="space-y-2.5">
        <h3 class="text-xl sm:text-2xl lg:text-[26px] font-normal tracking-tight text-[var(--color-primary)] flex items-center gap-2">
          {project.link ? (
            <a
              href={project.link}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:underline inline-flex items-center gap-1.5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[var(--color-primary)] rounded"
            >
              <span>{project.title}</span>
              <span class="text-sm font-normal text-[var(--color-secondary)] group-hover:text-[var(--color-primary)] transition-colors">↗</span>
            </a>
          ) : (
            <span>{project.title}</span>
          )}
        </h3>
        <p class="text-[15px] sm:text-base text-[var(--color-secondary)] leading-relaxed">
          {project.description}
        </p>
      </div>

      <!-- Technology Tags & Action Links -->
      <div class="space-y-5 pt-1">
        <div class="flex flex-wrap gap-2">
          {project.tags.map((tag) => (
            <span class="chip text-xs sm:text-[13px] px-3 py-0.5">{tag}</span>
          ))}
        </div>

        <!-- Links Row -->
        <div class="flex items-center gap-5 pt-1 text-xs sm:text-sm">
          {project.link && (
            <a
              href={project.link}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 font-medium text-[var(--color-primary)] hover:opacity-80 transition-opacity focus-visible:outline focus-visible:outline-2 focus-visible:outline-[var(--color-primary)] rounded"
            >
              <span>Live Site</span>
              <span class="text-[11px]">↗</span>
            </a>
          )}
          {project.github && (
            <a
              href={project.github}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-[var(--color-secondary)] hover:text-[var(--color-primary)] transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-[var(--color-primary)] rounded"
            >
              <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
              </svg>
              <span>Repository</span>
              <span class="text-[11px]">↗</span>
            </a>
          )}
        </div>
      </div>
    </div>
  </div>
</article>
