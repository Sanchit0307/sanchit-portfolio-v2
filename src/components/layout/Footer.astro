---
import { PERSONAL_INFO } from '../../data/siteData';

const currentYear = new Date().getFullYear();
---

<footer class="w-full border-t border-[var(--color-border)] mt-auto py-10 sm:py-12 bg-[var(--bg-page)] transition-colors">
  <div class="max-w-[1340px] mx-auto px-6 sm:px-8 lg:px-12 flex flex-col md:flex-row items-center justify-between gap-6 text-xs text-[var(--color-secondary)]">
    <!-- Identity and Branch -->
    <div class="flex flex-wrap items-center justify-center md:justify-start gap-2.5">
      <span class="font-medium text-[var(--color-primary)]">{PERSONAL_INFO.name}</span>
      <span class="text-[var(--color-border)]">·</span>
      <span class="font-mono">{PERSONAL_INFO.branch} {PERSONAL_INFO.batch}</span>
      <span class="text-[var(--color-border)]">·</span>
      <span class="font-mono">© {currentYear}</span>
    </div>

    <!-- Links -->
    <div class="flex items-center gap-6 text-xs">
      <a
        href={PERSONAL_INFO.github}
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-[var(--color-primary)] transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-[var(--color-primary)] rounded py-1"
      >
        GitHub
      </a>
      <a
        href={PERSONAL_INFO.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-[var(--color-primary)] transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-[var(--color-primary)] rounded py-1"
      >
        LinkedIn
      </a>
      <a
        href={`mailto:${PERSONAL_INFO.email}`}
        class="hover:text-[var(--color-primary)] transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-[var(--color-primary)] rounded py-1"
      >
        Email
      </a>
    </div>
  </div>
</footer>
