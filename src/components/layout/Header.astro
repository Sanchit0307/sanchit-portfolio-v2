---
import { NAV_ITEMS, PERSONAL_INFO } from '../../data/siteData';
import ThemeToggle from './ThemeToggle';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header
  id="main-header"
  transition:persist="main-header"
  class="sticky top-0 z-50 w-full border-b border-[var(--color-border)] bg-[var(--bg-page)]/85 backdrop-blur-md transition-colors"
>
  <div class="max-w-[1340px] mx-auto px-6 sm:px-8 lg:px-12 h-16 sm:h-20 grid grid-cols-2 md:grid-cols-3 items-center">
    <!-- Left Section: Avatar Logo -->
    <div class="flex items-center justify-start">
      <a
        href="/"
        class="group inline-flex items-center gap-3 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[var(--color-primary)] rounded-full transition-opacity hover:opacity-85"
        aria-label="Sanchit Marwah - Homepage"
      >
        <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-full overflow-hidden border border-[var(--color-border)] bg-[var(--color-muted)] shadow-2xs shrink-0 transition-transform duration-200 group-hover:scale-105">
          <img
            src="/images/portrait.jpg"
            alt="Sanchit Marwah"
            class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-300"
            loading="eager"
            decoding="async"
          />
        </div>
      </a>
    </div>

    <!-- Centre Section: Navigation Links in one horizontal row -->
    <nav class="hidden md:flex items-center justify-center gap-6 lg:gap-8" aria-label="Main Navigation">
      {NAV_ITEMS.map((item) => {
        const isExact = pathname === item.href;
        const isPrefix = item.href !== '/' && pathname.startsWith(item.href);
        const isDashboardMatch = (item.href === '/github' && (pathname === '/github' || pathname === '/dashboard'));
        const isJourneyMatch = (item.href === '/achievements' && (pathname === '/achievements' || pathname === '/journey'));
        const isActive = isExact || isPrefix || isDashboardMatch || isJourneyMatch;

        return (
          <a
            href={item.href}
            data-href={item.href}
            class:list={[
              'nav-link text-sm lg:text-[15px] transition-colors py-1.5 relative focus-visible:outline focus-visible:outline-2 focus-visible:outline-[var(--color-primary)] rounded',
              isActive
                ? 'font-medium text-[var(--color-primary)]'
                : 'text-[var(--color-secondary)] hover:text-[var(--color-primary)]'
            ]}
            aria-current={isActive ? 'page' : undefined}
          >
            <span>{item.label}</span>
            <span
              class:list={[
                'nav-indicator absolute -bottom-[21px] sm:-bottom-[29px] left-0 right-0 h-[2px] bg-[var(--color-primary)] rounded-full transition-all duration-250 ease-out pointer-events-none origin-center',
                isActive ? 'opacity-100 scale-x-100' : 'opacity-0 scale-x-50'
              ]}
              aria-hidden="true"
            />
          </a>
        );
      })}
    </nav>

    <!-- Right Section: Utility Controls -->
    <div class="flex items-center justify-end gap-2.5 sm:gap-3">
      <ThemeToggle client:load />

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="md:hidden inline-flex items-center justify-center w-9 h-9 rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] text-[var(--color-secondary)] hover:text-[var(--color-primary)] transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-[var(--color-primary)] cursor-pointer"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg
          class="w-4 h-4 menu-open-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="4" x2="20" y1="12" y2="12"></line>
          <line x1="4" x2="20" y1="6" y2="6"></line>
          <line x1="4" x2="20" y1="18" y2="18"></line>
        </svg>
        <svg
          class="w-4 h-4 menu-close-icon hidden"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-[var(--color-border)] bg-[var(--color-surface)] px-6 py-4 shadow-md"
  >
    <nav class="flex flex-col gap-1.5" aria-label="Mobile Navigation">
      {NAV_ITEMS.map((item) => {
        const isExact = pathname === item.href;
        const isPrefix = item.href !== '/' && pathname.startsWith(item.href);
        const isDashboardMatch = (item.href === '/github' && (pathname === '/github' || pathname === '/dashboard'));
        const isJourneyMatch = (item.href === '/achievements' && (pathname === '/achievements' || pathname === '/journey'));
        const isActive = isExact || isPrefix || isDashboardMatch || isJourneyMatch;

        return (
          <a
            href={item.href}
            data-href={item.href}
            class:list={[
              'mobile-nav-link text-sm py-2 px-3 rounded-lg transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-[var(--color-primary)]',
              isActive
                ? 'font-medium text-[var(--color-primary)] bg-[var(--color-muted)]'
                : 'text-[var(--color-secondary)] hover:text-[var(--color-primary)] hover:bg-[var(--color-muted)]/50'
            ]}
            aria-current={isActive ? 'page' : undefined}
          >
            {item.label}
          </a>
        );
      })}
    </nav>
  </div>
</header>

<script>
  function updateNav() {
    const rawPath = window.location.pathname.replace(/\/$/, '') || '/';

    // Update Desktop Nav
    document.querySelectorAll<HTMLAnchorElement>('#main-header .nav-link').forEach((link) => {
      const href = (link.getAttribute('data-href') || link.getAttribute('href') || '').replace(/\/$/, '') || '/';
      const isExact = rawPath === href;
      const isPrefix = href !== '/' && rawPath.startsWith(href);
      const isDashboardMatch = (href === '/github' && (rawPath === '/github' || rawPath === '/dashboard'));
      const isJourneyMatch = (href === '/achievements' && (rawPath === '/achievements' || rawPath === '/journey'));
      const isActive = isExact || isPrefix || isDashboardMatch || isJourneyMatch;

      if (isActive) {
        link.classList.add('font-medium', 'text-[var(--color-primary)]');
        link.classList.remove('text-[var(--color-secondary)]');
        link.setAttribute('aria-current', 'page');
        const ind = link.querySelector('.nav-indicator');
        if (ind) {
          ind.classList.remove('opacity-0', 'scale-x-50');
          ind.classList.add('opacity-100', 'scale-x-100');
        }
      } else {
        link.classList.remove('font-medium', 'text-[var(--color-primary)]');
        link.classList.add('text-[var(--color-secondary)]');
        link.removeAttribute('aria-current');
        const ind = link.querySelector('.nav-indicator');
        if (ind) {
          ind.classList.remove('opacity-100', 'scale-x-100');
          ind.classList.add('opacity-0', 'scale-x-50');
        }
      }
    });

    // Update Mobile Nav
    document.querySelectorAll<HTMLAnchorElement>('#main-header .mobile-nav-link').forEach((link) => {
      const href = (link.getAttribute('data-href') || link.getAttribute('href') || '').replace(/\/$/, '') || '/';
      const isExact = rawPath === href;
      const isPrefix = href !== '/' && rawPath.startsWith(href);
      const isDashboardMatch = (href === '/github' && (rawPath === '/github' || rawPath === '/dashboard'));
      const isJourneyMatch = (href === '/achievements' && (rawPath === '/achievements' || rawPath === '/journey'));
      const isActive = isExact || isPrefix || isDashboardMatch || isJourneyMatch;

      if (isActive) {
        link.classList.add('font-medium', 'text-[var(--color-primary)]', 'bg-[var(--color-muted)]');
        link.classList.remove('text-[var(--color-secondary)]');
        link.setAttribute('aria-current', 'page');
      } else {
        link.classList.remove('font-medium', 'text-[var(--color-primary)]', 'bg-[var(--color-muted)]');
        link.classList.add('text-[var(--color-secondary)]');
        link.removeAttribute('aria-current');
      }
    });
  }

  function setupHeader() {
    const menuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const openIcon = menuBtn?.querySelector('.menu-open-icon');
    const closeIcon = menuBtn?.querySelector('.menu-close-icon');

    if (menuBtn && mobileMenu && openIcon && closeIcon) {
      menuBtn.onclick = () => {
        const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
        menuBtn.setAttribute('aria-expanded', String(!isExpanded));
        mobileMenu.classList.toggle('hidden');
        openIcon.classList.toggle('hidden');
        closeIcon.classList.toggle('hidden');
      };

      // Close menu when a link is clicked
      mobileMenu.querySelectorAll('a').forEach((link) => {
        link.onclick = () => {
          menuBtn.setAttribute('aria-expanded', 'false');
          mobileMenu.classList.add('hidden');
          openIcon.classList.remove('hidden');
          closeIcon.classList.add('hidden');
        };
      });
    }

    updateNav();
  }

  setupHeader();
  document.addEventListener('astro:page-load', setupHeader);
  document.addEventListener('astro:after-swap', updateNav);
</script>
