---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { PERSONAL_INFO } from '../data/siteData';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = PERSONAL_INFO.bio } = Astro.props;
const pageTitle = title ? `${title} — ${PERSONAL_INFO.name}` : `${PERSONAL_INFO.name} — ${PERSONAL_INFO.role}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://sanchitmarwah.dev');

// Fluid page transition matching exact tuning:
// Exit: ~180ms subtle opacity + 4px upward translation
// Enter: ~280ms subtle opacity + 6px translation
const pageTransition = {
  forwards: {
    old: {
      name: 'pageExit',
      duration: '180ms',
      easing: 'cubic-bezier(0.4, 0, 1, 1)',
      fillMode: 'both',
    },
    new: {
      name: 'pageEnter',
      duration: '280ms',
      easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
      fillMode: 'both',
    },
  },
  backwards: {
    old: {
      name: 'pageExit',
      duration: '180ms',
      easing: 'cubic-bezier(0.4, 0, 1, 1)',
      fillMode: 'both',
    },
    new: {
      name: 'pageEnter',
      duration: '280ms',
      easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
      fillMode: 'both',
    },
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={PERSONAL_INFO.name} />

    <!-- Open Graph / Social Sharing Metadata -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={PERSONAL_INFO.name} />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <ClientRouter />

    <!-- Avoid theme flicker script (runs on initial load and View Transitions swap) -->
    <script is:inline>
      function applyTheme() {
        const stored = typeof localStorage !== 'undefined' ? localStorage.getItem('theme') : null;
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = stored ? stored : (prefersDark ? 'dark' : 'light');
        if (theme === 'dark') {
          document.documentElement.classList.add('dark');
          document.documentElement.dataset.theme = 'dark';
        } else {
          document.documentElement.classList.remove('dark');
          document.documentElement.dataset.theme = 'light';
        }
      }
      applyTheme();
      document.addEventListener('astro:after-swap', applyTheme);
    </script>
  </head>
  <body class="flex flex-col min-h-screen">
    <Header transition:persist="main-header" />
    <main
      id="main-content"
      data-page-content
      transition:name="page-content"
      transition:animate={pageTransition}
      class="flex-1 w-full max-w-[1340px] mx-auto px-6 sm:px-8 lg:px-12 py-10 sm:py-16 lg:py-20"
    >
      <slot />
    </main>
    <Footer transition:persist="main-footer" />

    <script>
      import { initScrollAnimations } from '../scripts/scrollAnimations';
      initScrollAnimations();
      document.addEventListener('astro:page-load', initScrollAnimations);
    </script>
  </body>
</html>
